{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos de la ventana de configuración y del indicador flotante",
  "windows": [
    "main",
    "overlay"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "opener:allow-open-url",
    "updater:default"
  ]
}
