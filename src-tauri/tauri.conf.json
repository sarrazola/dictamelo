{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Dictámelo",
  "version": "0.1.1",
  "identifier": "com.dictamelo.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Productivity",
    "shortDescription": "Dictámelo: dictado por voz para cualquier aplicación",
    "longDescription": "Mantén presionado un atajo global, habla y suelta: la transcripción se pega donde estaba el cursor.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "entitlements": "Entitlements.plist",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/sarrazola/dictamelo/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBOTY3Njg2QUY2RkMyNjMKUldSandtK3ZobmFXdW1XNVdpNGlscUtzcjZZRnp1aWlmWjF5T0hIVk04eDY5TERaYlgreGJ6OFgK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
