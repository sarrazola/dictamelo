# Public metadata for an official hosted build. A normal clean clone uses personal API keys.
# Copy this file to .env.cloud-build (ignored by Git), replace every placeholder, then run:
# python3 scripts/with-cloud-config.py -- cargo test --manifest-path src-tauri/Cargo.toml
# python3 scripts/with-cloud-config.py -- scripts/build-release.sh
# A different file can be selected with --config /path/to/public-build-config before --.
# Only literal KEY=value lines and full-line comments are accepted. Quotes are optional;
# no shell sourcing, variable expansion, or command substitution occurs.
# Never put service-role keys, Google client secrets, provider keys, SMTP passwords,
# Apple credentials, or updater signing keys here. Signing uses the existing secure workflow.
# Use the real IDs from your Lemon dashboard/API; a dashboard URL does not prove a product ID.

DICTAMELO_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
DICTAMELO_SUPABASE_ANON_KEY=REPLACE_WITH_PUBLIC_ANON_OR_PUBLISHABLE_KEY
DICTAMELO_LEMON_STORE_ID=REPLACE_WITH_STORE_ID
DICTAMELO_LEMON_PRODUCT_ID=REPLACE_WITH_PRODUCT_ID
DICTAMELO_LEMON_VARIANT_IDS=REPLACE_WITH_ALLOWED_VARIANT_IDS
DICTAMELO_CHECKOUT_URL=https://YOUR_STORE.lemonsqueezy.com/buy/REPLACE_WITH_CHECKOUT_ID

# Optional: leave the backend URL blank to use <Supabase URL>/functions/v1.
DICTAMELO_BACKEND_URL=
# Keep false until the actual configured checkout has a verified seven-day trial.
DICTAMELO_PRO_TRIAL_AVAILABLE=false
# Opt in only for official builds, or after configuring your own updater URL and public key
# in src-tauri/tauri.conf.json. This prevents a fork from replacing itself with our release.
DICTAMELO_UPDATES_ENABLED=false
